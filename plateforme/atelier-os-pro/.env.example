# Base de données de production (Neon / Vercel Postgres). Absente → PGlite (Postgres embarqué).
DATABASE_URL=
# Dossier PGlite en local (défaut : .data/pglite ; "memory://" pour une base éphémère)
PGLITE_DIR=
# Secret de signature des cookies de session (32 caractères minimum, obligatoire en production)
SESSION_SECRET=
# Mot de passe du compte administrateur plateforme (firas@ateliertruelle.fr), appliqué à chaque seed
ADMIN_PASSWORD=
# Mot de passe des comptes de démonstration (Plomberie Démo Paris 11e)
DEMO_PASSWORD=
# 1 = afficher le bandeau « mode démo » même hors Vercel
ATELIER_MODE_DEMO=
# 0 = ne pas appliquer les migrations au démarrage (les lancer avec npm run db:migrate)
ATELIER_MIGRER_AU_DEMARRAGE=
