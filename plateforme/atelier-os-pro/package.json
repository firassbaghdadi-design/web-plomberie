{
  "name": "atelier-os-pro",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "node scripts/embarquer-migrations.mjs && next build",
    "start": "next start -p 3200",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "db:generate": "drizzle-kit generate && node scripts/embarquer-migrations.mjs",
    "db:migrate": "tsx scripts/migrer.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "drizzle-orm": "0.45.2",
    "next": "14.2.35",
    "postgres": "3.4.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "0.31.4",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
