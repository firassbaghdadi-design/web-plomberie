# Mot de passe de la page de connexion
ADMIN_PASSWORD=
# Jeton pour l'API /api/v1 (en-tête Authorization: Bearer ...)
API_TOKEN=
# Secret de signature du cookie (au moins 32 caractères)
SESSION_SECRET=
# Fourni automatiquement par Vercel quand un magasin Blob est relié au projet.
# Sans lui, les données sont écrites dans data/db.json (développement).
BLOB_READ_WRITE_TOKEN=
# "true" pour autoriser l'envoyeur (désactivé par défaut)
EMAIL_SENDING_ENABLED=false
